---
import Layout from "../layouts/Layout.astro";
import Juego from "../interfaz/Juego.astro";
import { Mundo } from "../motor/nucleo/Mundo";

const mundo = new Mundo("WORSHIP WORLD");

mundo.crearSala({
	nombre: "Calle principal",
	tipo: "calle",
	ancho: 12,
	profundidad: 8,
});

mundo.crearSala({
	nombre: "Intersección central",
	tipo: "calle",
	ancho: 20,
	profundidad: 15,
});

mundo.crearSala({
	nombre: "Tienda de ropa",
	tipo: "tienda",
	ancho: 10,
	profundidad: 8,
	categoria: "ropa",
});

const configuracionesSalas = mundo.listarSalas().map((sala) => {
	const informacion = sala.obtenerInformacion();
	return {
		nombre: informacion.nombre,
		tipo: informacion.tipo,
		ancho: informacion.ancho,
		profundidad: informacion.profundidad,
		...(informacion.categoria
			? { categoria: informacion.categoria }
			: {}),
	};
});
---

<Layout>
	<Juego configuraciones={configuracionesSalas} />
</Layout>
